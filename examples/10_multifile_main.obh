// Демонстрація системи import: Point і допоміжні функції визначені в
// окремому файлі lib/mathutils.obh, а тут просто імпортуються.

import "lib/mathutils.obh"

fn main() -> Number {
    let p1 = Point(1, 2)
    let p2 = Point(3, 4)
    let sum = addPoints(p1, p2)
    print("Сума точок: x =", sum.x, "y =", sum.y)

    let numbers = [10, 20, 30]
    print("Сума списку:", sumList(numbers))

    return 0
}
