// 19_http.obh — HTTPS + JSON в Oberih

resilient fn getTodo(id: Number) -> String
    deadline(10s)
    retries(2)
    fallback(offlineTodo)
{
    let url = "https://jsonplaceholder.typicode.com/todos/" + toString(id)
    let resp = httpGet(url)?
    return resp.body
}

fn offlineTodo(id: Number) -> String {
    return "{\"error\": \"offline\"}"
}

resilient fn getPost(id: Number) -> String
    deadline(10s)
    retries(2)
    fallback(offlinePost)
{
    let url = "https://jsonplaceholder.typicode.com/posts/" + toString(id)
    let resp = httpGet(url)?
    return resp.body
}

fn offlinePost(id: Number) -> String {
    return "{\"error\": \"offline\"}"
}

fn parseTodo(raw: String) -> Number {
    let parsed = jsonParse(raw)
    let todo = match parsed {
        Ok(data) => data,
        Err(e)   => {
            println("Помилка парсингу: " + e)
            return 1
        }
    }
    println("title:     " + toString(todo.title))
    println("completed: " + toString(todo.completed))
    return 0
}

fn parsePost(raw: String) -> Number {
    let parsed = jsonParse(raw)
    let post = match parsed {
        Ok(data) => data,
        Err(e)   => {
            println("Помилка парсингу: " + e)
            return 1
        }
    }
    println("title: " + toString(post.title))
    return 0
}

fn main() -> Number {
    println("=== Oberih HTTPS + JSON ===")
    println("")

    println("GET https://jsonplaceholder.typicode.com/todos/1:")
    let raw = getTodo(1)
    println(raw)
    println("")
    parseTodo(raw)
    println("")

    println("GET https://jsonplaceholder.typicode.com/posts/1:")
    let postRaw = getPost(1)
    parsePost(postRaw)
    println("")

    gcstats()
    return 0
}
