fn describe(result: Number) -> String {
    return match result {
        1 => "один",
        2 => "два",
        _ => "щось інше"
    }
}

fn main() -> Number {
    print(describe(1))
    print(describe(2))
    print(describe(99))

    let ok = Ok("успіх")
    let err = Err("провал")

    let msg1 = match ok {
        Ok(v) => "Отримали: " + v,
        Err(e) => "Помилка: " + e
    }
    let msg2 = match err {
        Ok(v) => "Отримали: " + v,
        Err(e) => "Помилка: " + e
    }
    print(msg1)
    print(msg2)

    return 0
}
