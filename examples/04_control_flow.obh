// Демонстрація if/else та while - Oberih вже не тільки про resilience,
// а повноцінна мова, здатна виражати довільну логіку.
// Ці функції звичайні (без "resilient") - не вимагають deadline/retryBudget.

fn classify(amount: Number) -> String {
    if (amount > 1000) {
        return "large"
    } else {
        if (amount > 100) {
            return "medium"
        } else {
            return "small"
        }
    }
}

fn sumUpTo(n: Number) -> Number {
    let total = 0
    let i = 1
    while (i <= n) {
        total = total + i
        i = i + 1
    }
    return total
}

fn main() -> Number {
    print("classify(50) =", classify(50))
    print("classify(500) =", classify(500))
    print("classify(5000) =", classify(5000))
    print("sumUpTo(100) =", sumUpTo(100))
    return 0
}
