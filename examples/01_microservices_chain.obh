// Сценарій: агрегація даних замовлення з трьох мікросервісів.
// Демонструє ключову фічу Oberih — Shared Budget, яка запобігає retry storm.

resilient fn getOrderSummary(orderId: String) -> Result<OrderSummary, ResilienceExhausted>
    deadline(2s)              // обов'язково на корені — компілятор вимагає це
    retryBudget(6)             // спільний бюджет спроб на весь ланцюжок
    fallback(cachedSummary(orderId))
{
    let order = fetchOrder(orderId)?
    let user = fetchUser(order.userId)?
    let payment = fetchPaymentStatus(order.id)?
    return Ok(OrderSummary(order, user, payment))
}

resilient fn fetchOrder(id: String) -> Result<Order, Error>
    deadline(500ms)
    retries(3)   // стеля в межах спільного бюджету, не додаткові спроби
{
    return http.get("/orders/" + id)
}

resilient fn fetchUser(id: String) -> Result<User, Error>
    deadline(500ms)
    retries(3)
{
    return http.get("/users/" + id)
}

resilient fn fetchPaymentStatus(orderId: String) -> Result<PaymentStatus, Error>
    deadline(500ms)
    retries(2)
{
    return http.get("/payments/" + orderId + "/status")
}

// Навіть якщо всі три виклики оголошують власний retries — сумарна кількість
// реальних мережевих запитів не перевищить retryBudget(6), встановлений вище.
