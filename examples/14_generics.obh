struct Box<T> {
    value: T
}

fn main() -> Number {
    let numberBox = Box(42)
    let stringBox = Box("привіт")

    print("numberBox.value:", numberBox.value)
    print("stringBox.value:", stringBox.value)

    let sum = numberBox.value + 8
    print("numberBox.value + 8 =", sum)

    return 0
}
