// Для профілювання: лише гарячий цикл (диспетчеризація інструкцій), ~15 інструкцій
// на ітерацію. 20M ітерацій ≈ 2 с — достатньо для семплювання профайлером.
fn main() -> Number {
    let i = 0
    let acc = 0
    while (i < 20000000) {
        acc = acc + i * 2
        i = i + 1
    }
    return acc
}
