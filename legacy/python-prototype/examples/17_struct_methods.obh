struct Point {
    x: Number,
    y: Number
}

fn Point.distance(self: Point) -> Number {
    return sqrt(self.x * self.x + self.y * self.y)
}

fn Point.moveBy(self: Point, dx: Number, dy: Number) -> Number {
    self.x = self.x + dx
    self.y = self.y + dy
    return 0
}

fn main() -> Number {
    let p = Point(3, 4)
    print("Початкова точка: x =", p.x, "y =", p.y)
    print("Відстань:", p.distance())

    p.moveBy(1, 1)
    print("Після moveBy(1,1): x =", p.x, "y =", p.y)
    print("Нова відстань:", p.distance())

    return 0
}
