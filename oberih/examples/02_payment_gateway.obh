// Сценарій: списання коштів з картки.
// Демонструє idempotent — без цієї позначки retries тут був би небезпечним,
// бо повторний виклик міг би списати гроші двічі.

resilient fn chargeCard(amount: Money, idempotencyKey: String) -> Result<Receipt, PaymentError>
    deadline(5s)
    retryBudget(2)                          // мало спроб — ретраїти платіж ризиковано
    idempotent(key: idempotencyKey)          // гарантія: повторний виклик безпечний
    circuitBreaker(failThreshold: 5, cooldown: 30s)
{
    return paymentGateway.charge(amount, idempotencyKey)
}
