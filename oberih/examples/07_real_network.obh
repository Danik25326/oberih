// Це не симуляція. Цей файл робить СПРАВЖНІЙ HTTP-запит до реального
// публічного API (PyPI), використовуючи Oberih через CLI за замовчуванням.

resilient fn fetchPackageInfo(name: String) -> Result<String, Error>
    deadline(10s)
    retryBudget(3)
    fallback("не вдалось з'єднатися з PyPI")
{
    let url = "https://pypi.org/pypi/" + name + "/json"
    let response = http.get(url)
    return response.info.summary
}

fn main() -> Number {
    let info = fetchPackageInfo("requests")
    print("Інформація про пакет 'requests' зі СПРАВЖНЬОГО PyPI:", info)
    return 0
}

