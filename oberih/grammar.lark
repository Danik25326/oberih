// Граматика Oberih v0.1 (MVP-підмножина)
// Покриває: resilient fn, модифікатори, let/return, виклики функцій,
// доступ через крапку (obj.method), оператор "?", Ok/Err.

start: (import_stmt | fn_decl | struct_decl | enum_decl)+

import_stmt: "import" STRING

enum_decl: "enum" NAME "{" NAME ("," NAME)* "}"

struct_decl: PRIVATE_KW? "struct" NAME generic_params? "{" struct_field ("," struct_field)* "}"
struct_field: NAME ":" type_expr

RESILIENT_KW: "resilient"

fn_decl: PRIVATE_KW? RESILIENT_KW? "fn" NAME method_suffix? generic_params? "(" params? ")" "->" type_expr modifier* "{" block "}"

method_suffix: "." NAME

generic_params: "<" NAME ("," NAME)* ">"

PRIVATE_KW: "private"

block: stmt*

params: param ("," param)*
param: NAME ":" type_expr

type_expr: NAME ("<" type_expr ("," type_expr)* ">")?

modifier: NAME "(" mod_arg ("," mod_arg)* ")"  -> modifier
        | NAME                                  -> bare_modifier
        // durable, traced (без аргументів) парсяться через bare_modifier

mod_arg: NAME ":" value   -> named_arg
       | value             -> positional_arg

value: duration | primary

duration: SIGNED_NUMBER TIME_UNIT
TIME_UNIT: "ms" | "s" | "m"

?stmt: let_stmt
     | return_stmt
     | if_stmt
     | while_stmt
     | for_stmt
     | expr_or_assign_stmt

let_stmt: "let" NAME "=" expr
return_stmt: "return" expr
expr_or_assign_stmt: expr ("=" expr)?

for_stmt: "for" "(" NAME "in" expr ")" "{" block "}"

if_stmt: "if" "(" expr ")" "{" block "}" ("else" "{" block "}")?
while_stmt: "while" "(" expr ")" "{" block "}"

?expr: try_expr
     | match_expr

match_expr: "match" expr "{" match_arm ("," match_arm)* ","? "}"
match_arm: pattern "=>" expr

pattern: NAME "(" NAME ")"   -> ctor_pattern
       | "_"                 -> wildcard_pattern
       | STRING               -> literal_pattern
       | SIGNED_NUMBER         -> literal_pattern
       | BOOL                  -> literal_pattern
       | NAME                  -> variant_pattern

?try_expr: comparison "?"   -> try_op
         | comparison

?comparison: add_expr CMP_OP add_expr   -> comparison
           | add_expr

CMP_OP: "==" | "!=" | "<=" | ">=" | "<" | ">"

?add_expr: add_expr "+" mul_expr   -> add
         | add_expr "-" mul_expr   -> sub
         | mul_expr

?mul_expr: mul_expr "*" primary   -> mul
         | mul_expr "/" primary   -> div
         | primary

?primary: atom postfix*

atom: STRING
    | SIGNED_NUMBER
    | BOOL
    | NAME
    | "(" expr ")"
    | list_literal
    | map_literal
    | spawn_expr

spawn_expr: "spawn" NAME "(" args? ")"

list_literal: "[" (expr ("," expr)*)? "]"
map_literal: "{" (map_entry ("," map_entry)*)? "}"
map_entry: expr ":" expr

BOOL.2: "true" | "false"

postfix: "." NAME "(" args? ")"   -> method_call
       | "." NAME                 -> field_access
       | "(" args? ")"            -> call_args
       | "[" expr "]"             -> index_access

args: expr ("," expr)*

NAME: /[a-zA-Z_][a-zA-Z0-9_]*/

%import common.ESCAPED_STRING -> STRING
%import common.SIGNED_NUMBER
%import common.WS
%import common.CPP_COMMENT
%ignore WS
%ignore CPP_COMMENT
