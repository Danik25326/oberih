{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Oberih",
  "scopeName": "source.oberih",
  "fileTypes": ["obh"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#modifiers" },
    { "include": "#builtin-objects" },
    { "include": "#types" },
    { "include": "#struct-decl" },
    { "include": "#function-decl" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.oberih",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.oberih",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.oberih",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.duration.oberih",
          "match": "\\b[0-9]+(\\.[0-9]+)?(ms|s|m)\\b"
        },
        {
          "name": "constant.numeric.oberih",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.oberih",
          "match": "\\b(if|else|while|return|let)\\b"
        },
        {
          "name": "keyword.declaration.oberih",
          "match": "\\b(fn|struct|resilient)\\b"
        },
        {
          "name": "constant.language.oberih",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "modifiers": {
      "comment": "Модифікатори стійкості - фірмова риса Oberih, підсвічуються окремо",
      "patterns": [
        {
          "name": "support.function.modifier.oberih",
          "match": "\\b(deadline|retryBudget|retries|timeout|fallback|emergencyFallback|circuitBreaker|idempotent|cache|rateLimit|bulkhead|hedging|budget|durable|traced)\\b"
        }
      ]
    },
    "builtin-objects": {
      "patterns": [
        {
          "name": "support.class.builtin.oberih",
          "match": "\\b(http|paymentGateway|weatherApi|llm|agent)\\b(?=\\.)"
        },
        {
          "name": "support.function.builtin.oberih",
          "match": "\\b(print|len)\\b(?=\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.oberih",
          "match": "\\b(Number|String|Boolean|Result|Option|List|Map|Order|User|Money)\\b"
        }
      ]
    },
    "struct-decl": {
      "patterns": [
        {
          "match": "\\bstruct\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.struct.oberih" }
          }
        }
      ]
    },
    "function-decl": {
      "patterns": [
        {
          "match": "\\bfn\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.oberih" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.oberih"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.oberih",
          "match": "(\\+|\\-|\\*|/|==|!=|<=|>=|<|>|=|\\?)"
        }
      ]
    }
  }
}
